# ============================================================================
# mapin — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle — never put
# secrets in them. Everything else is read on the server only.
# ============================================================================

# --- App -------------------------------------------------------------------
# Public origin of the app (e.g. https://mapin.xyz). Used for wallet sign-in, token links and the on-chain logo URL.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ random bytes, used to sign session cookies. Generate on Windows PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# or with Node:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Database (PostgreSQL 14+ or Supabase) ----------------------------------
# Local:    postgres://postgres:postgres@localhost:5432/mapin
# Supabase: Project Settings → Database → Connection string (URI, "Session" pooler).
# This value is a server secret; it never reaches the browser.
DATABASE_URL=
# Set to "true" when your provider requires TLS (Supabase / most hosted Postgres).
DATABASE_SSL=false

# --- Owner escrow (REQUIRED to tokenize) -----------------------------------
# Every mapin token sends the owner's share of each trade here (the Pons creatorFeeRecipient) until the
# real owner claims the business. Use a NEW wallet used for nothing else, ideally a hardware wallet or a
# Safe multisig. Never put its private key anywhere in this project.
NEXT_PUBLIC_OWNER_ESCROW_ADDRESS=
# Owner's share of every curve trade in basis points (70 = 0.7 %). Changing it only affects new tokens.
NEXT_PUBLIC_OWNER_FEE_BPS=70

# --- Admin -----------------------------------------------------------------
# Password for https://<your domain>/admin (owner claims and takedown requests). 24+ random characters.
ADMIN_TOKEN=

# --- Map data (OpenStreetMap, worldwide, free) -------------------------------
# Tiles: OpenFreeMap (no key). Any MapLibre style URL works here (MapTiler, Stadia, …).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Place search and business lookup. The public servers are free with fair-use limits; for heavy traffic
# point these at a paid / self-hosted instance.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Contact e-mail sent to OpenStreetMap services (their usage policy asks for one).
OSM_CONTACT_EMAIL=

# --- Robinhood Chain RPC ----------------------------------------------------
# Robinhood Chain mainnet: chain ID 4663, native currency ETH, explorer robinhoodchain.blockscout.com
# Server-side RPC (simulation checks, receipt verification, launch terms). The official public
# endpoint works for light use; a private endpoint (Alchemy, QuickNode, …) is recommended in
# production. Keep API keys here, not in the NEXT_PUBLIC_ variable below.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# RPC used by the indexer. MUST support eth_getLogs over large block ranges
# (Robinhood Chain makes ~10 blocks per second).
ROBINHOOD_INDEXER_RPC_URL=
# eth_getLogs block span per request (default 20000 ≈ 33 minutes of blocks). Lower it if your RPC
# rejects the range.
INDEXER_CHUNK=20000
# First block to index. Leave empty to start from the current head on first run.
INDEXER_START_BLOCK=
# Shared secret for POST /api/indexer/run (for a cron job). Leave empty to disable the route.
INDEXER_SECRET=

# Browser RPC used by wagmi for reads (balances, quotes, simulations).
# Public, rate-limited endpoint is fine; it is visible to every visitor.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Token metadata / IPFS --------------------------------------------------
# Token logos + metadata JSON are pinned to IPFS through this public upload API (no credentials
# required; chain-independent). It is called only from the server route /api/metadata. The logo
# URL written on-chain into the token is https://<your domain>/api/ipfs/<image CID>.
METADATA_UPLOAD_URL=https://funcs.flap.sh/api/upload
# Gateway the server uses to read metadata JSON / images (proxied through /api/ipfs/<cid>).
IPFS_GATEWAY_URL=https://flap.mypinata.cloud/ipfs/

# --- Privy (optional wallet login) -----------------------------------------
# When set, "Connect Wallet" opens Privy: external wallets (MetaMask, Rabby, OKX,
# Robinhood Wallet, WalletConnect…) plus login with email that creates a wallet automatically.
# Leave empty to use the built-in wallet picker. dashboard.privy.io → your app → Settings.
# Both values are public identifiers (not secrets).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
