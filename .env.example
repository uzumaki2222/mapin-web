# ============================================================================
# mapin — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle — never put
# secrets in them. Everything else is read on the server only.
# ============================================================================

# --- App -------------------------------------------------------------------
# Public origin of the app. Used for wallet sign-in domain binding and links.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ random bytes, used to sign session cookies. Generate on Windows PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# or with Node:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Database (PostgreSQL 14+ or Supabase) ----------------------------------
# Local:    postgres://postgres:postgres@localhost:5432/mapin
# Supabase: Project Settings → Database → Connection string (URI, "Session" pooler).
# This value is a server secret; it never reaches the browser.
DATABASE_URL=
# Set to "true" when your provider requires TLS (Supabase / most hosted Postgres).
DATABASE_SSL=false

# --- Admin -----------------------------------------------------------------
# Password for https://<your domain>/admin (reports on token pages). 24+ random characters.
ADMIN_TOKEN=

# --- Map data (OpenStreetMap, worldwide, free) -------------------------------
# Tiles: OpenFreeMap (no key). Any MapLibre style URL works here.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Place search and area lookup. The public server is free with fair-use limits.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact e-mail sent to OpenStreetMap services (their usage policy asks for one).
OSM_CONTACT_EMAIL=

# --- BNB Smart Chain RPC ----------------------------------------------------
# Server-side RPC (simulation checks, receipt verification, quote-token discovery).
# The official public endpoint works for light use; a private endpoint
# (NodeReal, QuickNode, Ankr, …) is recommended in production. Keep API keys here,
# not in the NEXT_PUBLIC_ variable below.
RPC_URL=https://bsc-dataseed.bnbchain.org

# RPC used by the indexer. MUST support eth_getLogs over ranges of a few
# thousand blocks (the public bsc-dataseed endpoints usually do not).
INDEXER_RPC_URL=
# First block to index. Leave empty to start from the current head on first run.
INDEXER_START_BLOCK=
# Shared secret for POST /api/indexer/run (for a cron job). Leave empty to disable the route.
INDEXER_SECRET=

# Browser RPC used by wagmi for reads (balances, quotes, simulations).
# Public, rate-limited endpoint is fine; it is visible to every visitor.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# --- Token metadata / IPFS --------------------------------------------------
# The launch protocol pins token metadata through its own public upload API
# (no credentials required). It is called only from the server route
# /api/metadata so the browser never talks to it directly.
METADATA_UPLOAD_URL=https://funcs.flap.sh/api/upload
# Gateway the server uses to read metadata JSON / images (proxied through /api/ipfs/<cid>).
IPFS_GATEWAY_URL=https://flap.mypinata.cloud/ipfs/

# --- Privy (optional wallet login) -----------------------------------------
# When set, "Connect Wallet" opens Privy: external wallets (MetaMask, Rabby, OKX,
# Binance, WalletConnect…) plus login with email that creates a wallet automatically.
# Leave empty to use the built-in wallet picker. dashboard.privy.io → your app → Settings.
# Both values are public identifiers (not secrets).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
