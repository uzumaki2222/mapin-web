{
  "name": "mapin",
  "version": "0.1.0",
  "private": true,
  "description": "mapin \u2014 a token launchpad on a world map: tokenize any place on BNB Smart Chain (Flap).",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:contracts": "node --import tsx scripts/verify-contracts.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "indexer": "node --conditions=react-server --import tsx scripts/indexer.ts",
    "indexer:once": "node --conditions=react-server --import tsx scripts/indexer.ts --once",
    "gen:abi": "python scripts/gen-portal-abi.py",
    "test:abi-offline": "node scripts/verify-abi-offline.mjs"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.45.0",
    "@privy-io/wagmi": "^4.0.17",
    "@tanstack/react-query": "^5.90.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "viem": "2.56.0",
    "wagmi": "^3.7.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.6",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
